# Optional AI wording for the analyst's forecasts (api/advise.js). The game works fully without these.
# The physics, forecasts and scoring never call an AI model; the model only rewords numbers the game already computed.
# Free option (no credit card): a Groq key from https://console.groq.com/keys
ADVISOR_API_KEY=
# A small, non-reasoning chat model is enough for 70-word answers. Groq lists this as a production model (checked 2026-11-14).
ADVISOR_MODEL=llama-3.1-8b-instant
# Default is Groq. Any OpenAI-compatible endpoint works, for example Google's Gemini free tier:
#   ADVISOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   (use a model ID from Google's docs)
ADVISOR_BASE_URL=https://api.groq.com/openai/v1
# Only if the page is served from a different origin than the function (comma-separated)
ALLOWED_ORIGINS=
