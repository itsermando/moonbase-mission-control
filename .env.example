# Optional AI wording for the analyst's forecasts (api/advise.js on Vercel). The game works fully without these.
# The physics, forecasts and scoring never call an AI model; the model only rewords numbers the game already computed.
AI_GATEWAY_API_KEY=
# An exact model ID from https://ai-gateway.vercel.sh/v1/models (checked 2026-11-14; short answers, so a small model is enough)
ADVISOR_MODEL=llama-3.1-8b-instant
# Only if the page is served from a different origin than the function (comma-separated)
ALLOWED_ORIGINS=
